# 全新配置时应用的项目默认值(sdkconfig 本身被 gitignore)。
# 16MB Flash + 自定义分区表(factory 应用分区更大)。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 状态 RGB 灯:板载 WS2812(可寻址、单数据线)位于 GPIO48
# (ESP32-S3-DevKitC-1)。规范 §5:WS2812 必须使用专用驱动。
CONFIG_APP_LED_WS2812_GPIO=48

# 串口日志级别 INFO:温度探测、MQTT 收发等日志均在此级别输出
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
